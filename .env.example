# ─────────────────────────────────────────────────────────────
#  Facebook Messenger (хэрэглэгчтэй харилцах бот)
# ─────────────────────────────────────────────────────────────
# Өөрөө зохиох нууц үг. Facebook webhook тохируулахдаа мөн үүнийг бичнэ.
FB_VERIFY_TOKEN=
# Facebook App → Messenger → Generate token (Page-ээ сонгож)
FB_PAGE_ACCESS_TOKEN=
# Facebook App → Settings → Basic → App Secret
FB_APP_SECRET=

# ─────────────────────────────────────────────────────────────
#  Telegram (админ / мэдээллийн сан засварлагч AI)
# ─────────────────────────────────────────────────────────────
# @BotFather → /newbot → токен
TELEGRAM_BOT_TOKEN=
# Зөвхөн эдгээр chat id ботод хандана. Таслалаар тусгаарлана: 123456789,987654321
TELEGRAM_ADMIN_CHAT_IDS=
# Өөрөө зохиох нууц үг (webhook-ийн хамгаалалт)
TELEGRAM_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
#  Claude (Anthropic)
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Загварыг солих бол энд бич. claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-5

# ─────────────────────────────────────────────────────────────
#  Upstash Redis (Vercel → Storage → Upstash үүсгэвэл автоматаар нэмэгдэнэ)
# ─────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
